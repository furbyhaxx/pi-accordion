{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/furbyhaxx/pi-accordion/feat/pi-native/extension/skills/accordion-task-lists/references/tasks.schema.json",
  "title": "Accordion task list (version 2)",
  "description": "One task list per file at <project>/.pig/tasks/<slug>.json. Tasks may nest to any depth; ids are derived from position and may be omitted.",
  "type": "object",
  "required": ["version", "slug", "title", "goal", "tasks"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "version": { "const": 2 },
    "slug": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$", "description": "Must equal the file name without .json." },
    "title": { "type": "string", "minLength": 1, "maxLength": 200 },
    "goal": { "type": "string", "minLength": 1, "maxLength": 600, "description": "The end state this whole list delivers." },
    "pins": { "type": "array", "items": { "$ref": "#/$defs/pin" } },
    "attachments": { "type": "array", "items": { "$ref": "#/$defs/attachment" } },
    "createdAt": { "type": "string" },
    "updatedAt": { "type": "string" },
    "claim": {
      "description": "Which session works on the list. Leave null in a hand-written file.",
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "required": ["session", "at"],
          "properties": { "session": { "type": "string" }, "at": { "type": "string" }, "name": { "type": "string" } }
        }
      ]
    },
    "tasks": { "type": "array", "items": { "$ref": "#/$defs/task" } }
  },
  "$defs": {
    "pin": {
      "type": "object",
      "required": ["id", "kind", "text", "source", "at"],
      "properties": {
        "id": { "type": "string", "pattern": "^p[1-9][0-9]*$" },
        "kind": { "enum": ["rule", "convention", "constraint", "standard", "fact"] },
        "text": { "type": "string", "minLength": 1, "maxLength": 300 },
        "source": { "type": "string", "minLength": 1 },
        "at": { "type": "string" }
      }
    },
    "attachment": {
      "type": "object",
      "required": ["id", "path"],
      "properties": {
        "id": { "type": "string", "pattern": "^a[1-9][0-9]*$" },
        "path": { "type": "string", "minLength": 1 },
        "lines": { "type": "string", "pattern": "^[1-9][0-9]*(-[1-9][0-9]*)?$" },
        "note": { "type": "string", "maxLength": 120 },
        "hash": { "type": "string" },
        "at": { "type": "string" }
      }
    },
    "task": {
      "type": "object",
      "required": ["title"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[1-9][0-9]*(\\.[1-9][0-9]*)*$", "description": "Optional; must equal the task's position." },
        "title": { "type": "string", "minLength": 1, "maxLength": 200 },
        "status": { "enum": ["todo", "doing", "blocked", "done", "failed", "abandoned"], "default": "todo" },
        "pins": { "type": "array", "items": { "$ref": "#/$defs/pin" } },
        "attachments": { "type": "array", "items": { "$ref": "#/$defs/attachment" } },
        "acceptanceCriteria": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": { "type": "string", "minLength": 1, "maxLength": 120 },
          "description": "Checkable statements that are true when the task is finished."
        },
        "report": {
          "type": "object",
          "required": ["outcome"],
          "properties": {
            "outcome": { "type": "string" },
            "decisions": { "type": "array", "items": { "type": "string" } },
            "open": { "type": "array", "items": { "type": "string" } }
          }
        },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" },
        "startedAt": { "type": "string" },
        "endedAt": { "type": "string" },
        "autoClosed": { "type": "boolean" },
        "blocks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["reason", "detail", "at"],
            "properties": {
              "reason": { "enum": ["user-decision", "user-input", "third-party", "dependency"] },
              "detail": { "type": "string" },
              "on": { "type": "string" },
              "at": { "type": "string" },
              "resumedAt": { "type": "string" }
            }
          }
        },
        "supersededBy": { "type": "string" },
        "subtasks": { "type": "array", "items": { "$ref": "#/$defs/task" } }
      }
    }
  }
}
