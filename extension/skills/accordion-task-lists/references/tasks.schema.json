{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://raw.githubusercontent.com/furbyhaxx/pi-accordion/feat/pi-native/extension/skills/accordion-task-lists/references/tasks.schema.json",
	"title": "Accordion task list (version 2)",
	"description": "One task list per file at <project>/.pig/tasks/<slug>.json. Tasks may nest to any depth; ids are derived from position and may be omitted.",
	"type": "object",
	"required": [
		"version",
		"slug",
		"title",
		"goals",
		"tasks"
	],
	"additionalProperties": false,
	"properties": {
		"$schema": {
			"type": "string"
		},
		"version": {
			"const": 3
		},
		"slug": {
			"type": "string",
			"pattern": "^[a-z0-9][a-z0-9-]{0,63}$",
			"description": "Must equal the file name without .json."
		},
		"title": {
			"type": "string",
			"minLength": 1,
			"maxLength": 200
		},
		"goals": {
			"type": "array",
			"minItems": 1,
			"maxItems": 5,
			"items": {
				"$ref": "#/$defs/goal"
			},
			"description": "Together, the end state this whole list delivers."
		},
		"seq": {
			"type": "object",
			"additionalProperties": false,
			"properties": {
				"g": {
					"type": "integer",
					"minimum": 0
				},
				"c": {
					"type": "integer",
					"minimum": 0
				},
				"p": {
					"type": "integer",
					"minimum": 0
				},
				"a": {
					"type": "integer",
					"minimum": 0
				}
			},
			"description": "Store bookkeeping: the last number used per item id prefix, so removed ids are never reused. Leave it out when authoring."
		},
		"pins": {
			"type": "array",
			"items": {
				"$ref": "#/$defs/pin"
			}
		},
		"attachments": {
			"type": "array",
			"items": {
				"$ref": "#/$defs/attachment"
			}
		},
		"createdAt": {
			"type": "string"
		},
		"updatedAt": {
			"type": "string"
		},
		"claim": {
			"description": "Which session works on the list. Leave null in a hand-written file.",
			"oneOf": [
				{
					"type": "null"
				},
				{
					"type": "object",
					"required": [
						"session",
						"at"
					],
					"properties": {
						"session": {
							"type": "string"
						},
						"at": {
							"type": "string"
						},
						"name": {
							"type": "string"
						}
					}
				}
			]
		},
		"tasks": {
			"type": "array",
			"items": {
				"$ref": "#/$defs/task"
			}
		}
	},
	"$defs": {
		"pin": {
			"type": "object",
			"required": [
				"kind",
				"text",
				"source"
			],
			"properties": {
				"id": {
					"type": "string",
					"pattern": "^p[1-9][0-9]*$",
					"description": "Omit when authoring; the store assigns p<n>."
				},
				"kind": {
					"enum": [
						"rule",
						"convention",
						"constraint",
						"standard",
						"fact"
					]
				},
				"text": {
					"type": "string",
					"minLength": 1,
					"maxLength": 300,
					"description": "Verbatim quote from the source, never a paraphrase."
				},
				"source": {
					"type": "string",
					"minLength": 1,
					"description": "\"user\" (a user message of the session), \"path\", \"path:line\" or \"path:start-end\"."
				},
				"at": {
					"type": "string",
					"description": "Store bookkeeping; omit when authoring."
				}
			}
		},
		"attachment": {
			"type": "object",
			"required": [
				"path"
			],
			"properties": {
				"id": {
					"type": "string",
					"pattern": "^a[1-9][0-9]*$",
					"description": "Omit when authoring; the store assigns a<n>."
				},
				"path": {
					"type": "string",
					"minLength": 1,
					"description": "Project-relative path, or an absolute path under a configured tasks.attachments.roots entry."
				},
				"anchor": {
					"$ref": "#/$defs/anchor"
				},
				"lines": {
					"type": "string",
					"pattern": "^[1-9][0-9]*(-[1-9][0-9]*)?$",
					"description": "Legacy line range; replaced by a quote anchor when next delivered."
				},
				"note": {
					"type": "string",
					"maxLength": 120,
					"description": "Why this part matters to the task."
				},
				"hash": {
					"type": "string",
					"description": "Store bookkeeping; omit when authoring."
				},
				"at": {
					"type": "string"
				}
			}
		},
		"task": {
			"type": "object",
			"required": [
				"title"
			],
			"additionalProperties": false,
			"properties": {
				"id": {
					"type": "string",
					"pattern": "^[1-9][0-9]*(\\.[1-9][0-9]*)*$",
					"description": "Optional; must equal the task's position."
				},
				"title": {
					"type": "string",
					"minLength": 1,
					"maxLength": 200
				},
				"status": {
					"enum": [
						"todo",
						"doing",
						"blocked",
						"done",
						"failed",
						"abandoned"
					],
					"default": "todo"
				},
				"pins": {
					"type": "array",
					"items": {
						"$ref": "#/$defs/pin"
					}
				},
				"attachments": {
					"type": "array",
					"items": {
						"$ref": "#/$defs/attachment"
					}
				},
				"goals": {
					"type": "array",
					"maxItems": 3,
					"items": {
						"$ref": "#/$defs/taskGoal"
					}
				},
				"acceptanceCriteria": {
					"type": "array",
					"minItems": 1,
					"maxItems": 8,
					"items": {
						"$ref": "#/$defs/criterion"
					},
					"description": "Checkable statements that are true when the task is finished; 1–3 recommended."
				},
				"report": {
					"type": "object",
					"required": [
						"outcome"
					],
					"properties": {
						"outcome": {
							"type": "string"
						},
						"decisions": {
							"type": "array",
							"items": {
								"type": "string"
							}
						},
						"open": {
							"type": "array",
							"items": {
								"type": "string"
							}
						}
					}
				},
				"createdAt": {
					"type": "string"
				},
				"updatedAt": {
					"type": "string"
				},
				"startedAt": {
					"type": "string"
				},
				"endedAt": {
					"type": "string"
				},
				"autoClosed": {
					"type": "boolean"
				},
				"blocks": {
					"type": "array",
					"items": {
						"type": "object",
						"required": [
							"reason",
							"detail",
							"at"
						],
						"properties": {
							"reason": {
								"enum": [
									"user-decision",
									"user-input",
									"third-party",
									"dependency"
								]
							},
							"detail": {
								"type": "string"
							},
							"on": {
								"type": "string"
							},
							"at": {
								"type": "string"
							},
							"resumedAt": {
								"type": "string"
							}
						}
					}
				},
				"supersededBy": {
					"type": "string"
				},
				"subtasks": {
					"type": "array",
					"items": {
						"$ref": "#/$defs/task"
					}
				}
			}
		},
		"goal": {
			"description": "A goal: a plain string when authoring (the store assigns an id), or { id, text } as the store writes it.",
			"oneOf": [
				{
					"type": "string",
					"minLength": 1,
					"maxLength": 600
				},
				{
					"type": "object",
					"additionalProperties": false,
					"required": [
						"text"
					],
					"properties": {
						"id": {
							"type": "string",
							"pattern": "^g[1-9][0-9]*$"
						},
						"text": {
							"type": "string",
							"minLength": 1,
							"maxLength": 600
						}
					}
				}
			]
		},
		"taskGoal": {
			"description": "A task goal: what this subtree must achieve beyond its criteria.",
			"oneOf": [
				{
					"type": "string",
					"minLength": 1,
					"maxLength": 300
				},
				{
					"type": "object",
					"additionalProperties": false,
					"required": [
						"text"
					],
					"properties": {
						"id": {
							"type": "string",
							"pattern": "^g[1-9][0-9]*$"
						},
						"text": {
							"type": "string",
							"minLength": 1,
							"maxLength": 300
						}
					}
				}
			]
		},
		"criterion": {
			"description": "A checkable statement that is true when the task is finished: a plain string when authoring, or { id, text }.",
			"oneOf": [
				{
					"type": "string",
					"minLength": 1,
					"maxLength": 120
				},
				{
					"type": "object",
					"additionalProperties": false,
					"required": [
						"text"
					],
					"properties": {
						"id": {
							"type": "string",
							"pattern": "^c[1-9][0-9]*$"
						},
						"text": {
							"type": "string",
							"minLength": 1,
							"maxLength": 120
						}
					}
				}
			]
		},
		"anchor": {
			"description": "What part of the file an attachment points at.",
			"oneOf": [
				{
					"type": "object",
					"required": [
						"section"
					],
					"additionalProperties": false,
					"properties": {
						"section": {
							"type": "string",
							"minLength": 1,
							"description": "Markdown heading path, \"A > B\"."
						}
					}
				},
				{
					"type": "object",
					"required": [
						"symbol"
					],
					"additionalProperties": false,
					"properties": {
						"symbol": {
							"type": "string",
							"minLength": 1,
							"description": "Dotted declaration name."
						}
					}
				},
				{
					"type": "object",
					"required": [
						"quote"
					],
					"additionalProperties": false,
					"properties": {
						"quote": {
							"type": "object",
							"required": [
								"exact"
							],
							"additionalProperties": false,
							"properties": {
								"exact": {
									"type": "string",
									"minLength": 1
								},
								"prefix": {
									"type": "string"
								},
								"suffix": {
									"type": "string"
								},
								"start": {
									"type": "integer",
									"minimum": 0
								}
							},
							"description": "Exact text, unique in the file. prefix, suffix and start may be omitted when authoring; the store completes them."
						}
					}
				}
			]
		}
	}
}
